# Text: Claude Pro sau ChatGPT Plus prin Codex inclus. Fără API plătit separat.
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_LIGHT_MODEL=haiku
# Câte apeluri Claude are voie aplicația să facă în 5 ore (se poate schimba și din Setări)
PRO_CALLS_PER_5H=90
# După câte minute se oprește un apel blocat
CLAUDE_TIMEOUT_MIN=12

# Aplicația se deschide doar pe calculatorul tău: http://localhost:4321
PORT=4321

# Baza de date (PostgreSQL în Docker, vezi docker-compose.yml)
STORAGE=postgres
PG_USER=wonderpages
PG_PASSWORD=wonderpages-local
PG_DB=wonderpages
DATABASE_URL=postgres://wonderpages:wonderpages-local@127.0.0.1:5433/wonderpages
DB_CONTAINER=wonderpages-db
# Imaginile generate (fișiere de lucru)
DATA_DIR=./data
# Fișierele finale (PDF, imagini, ZIP). Gol = Documente\WonderPages
OUTPUT_DIR=

# Opțional, doar dacă Canva cere o aplicație înregistrată (Developer Portal, cu Canva MCP activat)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_MCP_URL=https://mcp.canva.com/mcp

# Regulatorul de consum (abonamentul Pro)
MAX_PARALLEL_PROJECTS=1
LIMIT_COOLDOWN_MIN=60

# Opțional: Google Drive (Google Cloud Console > aplicație OAuth de tip „Desktop”, Google Drive API activat)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canva: buget local estimativ, nu sold oficial. La atingerea limitei, generarea se oprește.
CANVA_MONTHLY_ALLOWANCE=200
CANVA_RESET_DAY=1
CANVA_SPACING_SEC=12
CANVA_PAUSE_MIN=4
CANVA_CONCURRENCY=1

# HTTPS opțional pentru LAN: căi către certificatul și cheia proprii, păstrate în afara release-ului
WP_TLS_CERT=
WP_TLS_KEY=
WP_TLS_PORT=4322
